# ─── Prime Suite · configuración de una instalación ──────────────────────────
# install.sh crea el .env a partir de esta plantilla. No se sube nunca a ningún repositorio.

# Nombre de la instalación: separa contenedor y volumen de datos de otras instalaciones
# del mismo servidor. Solo minúsculas, números y guiones. No lo cambies después de instalar
# (el volumen de datos lleva este nombre).
COMPOSE_PROJECT_NAME=primesuite-prod

# Versión de Prime Suite (la cambia update.sh).
PRIME_VERSION=1.0.0
PRIME_IMAGE=ghcr.io/smondelof/primesuite

# URL EXACTA con la que entra el usuario, https y con el puerto si no es el 443.
# Sin barra final. Es el "issuer" del SSO.
PRIME_ISSUER=https://primesuite.vuestro-dominio.com:8443

# Clave maestra para cifrar los secretos guardados. install.sh la genera.
# NO la cambies después y guarda una copia segura: sin ella no se pueden leer los secretos.
PRIME_SECRET_KEY=

# Nombre de la cookie de sesión (empieza por ps_). Debe ser distinto en cada instalación
# que comparta dominio, porque las cookies no distinguen puertos.
PRIME_COOKIE_NAME=ps_session_prod

TZ=Europe/Madrid

# Puerto interno publicado en el host (al que apunta el balanceador o Caddy).
APP_PORT=18081
# 127.0.0.1 = solo desde el propio servidor; 0.0.0.0 = desde la red (protegedlo por firewall).
APP_BIND=127.0.0.1

# Solo para el modo HTTPS directo (perfil "tls"): dominio del certificado y puerto HTTPS público.
PRIME_DOMAIN=primesuite.vuestro-dominio.com
HTTPS_PORT=8443
# Carpeta con fullchain.pem y privkey.pem (por defecto ./certs). Puede ser la de otra instalación
# del mismo servidor, para compartir el certificado y sus renovaciones.
CERTS_DIR=./certs

# Almacenamiento (SQLite dentro del volumen de datos). No cambiar.
PRIME_STORE=sqlite
PRIME_SQLITE_PATH=/data/prime-suite.db
