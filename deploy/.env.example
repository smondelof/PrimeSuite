# ─── Prime Suite · configuración de la instalación ───────────────────────────
# URL pública EXACTA con la que se accede (https). Es el "issuer" del SSO y debe
# coincidir con lo que ve el navegador. No pongáis barra final.
PRIME_ISSUER=https://primesuite.vuestro-dominio.com

# Clave maestra para cifrar secretos en la base de datos (p. ej. contraseñas de Superset).
# Generad una cadena larga y aleatoria y NO la cambiéis después (invalidaría lo cifrado).
#   openssl rand -base64 48
PRIME_SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria

# Zona horaria del contenedor
TZ=Europe/Madrid

# ─── Normalmente no hace falta tocar nada de aquí abajo ──────────────────────
# Puerto interno de la app y a qué interfaz del host se publica.
APP_PORT=8080
# 127.0.0.1 = solo accesible desde el propio host (recomendado si el proxy va en la misma máquina).
# 0.0.0.0   = accesible desde la red (protegedlo por firewall) si el balanceador está en otra máquina.
APP_BIND=127.0.0.1

# Dominio para el modo HTTPS directo (perfil "tls" con Caddy). Si el TLS lo hace vuestro
# balanceador, ignorad esto.
PRIME_DOMAIN=primesuite.vuestro-dominio.com

# Almacenamiento: SQL Server. La conexión se configura desde la web la primera vez y se guarda en
# /data/sqlserver.json (contraseña cifrada con PRIME_SECRET_KEY). PRIME_SQLITE_PATH es el SQLite anterior,
# que solo se lee una vez para migrar sus datos. No cambiar.
PRIME_STORE=sqlserver
PRIME_SQLITE_PATH=/data/prime-suite.db
